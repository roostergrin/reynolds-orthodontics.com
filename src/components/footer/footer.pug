footer.footer
  .footer__container
    .footer__item
      AppIcon.footer__logo(name='logo-footer')
      a.footer__address(:href='content.location.address_link' v-html='content.location.address' target='_blank' rel='noopener noreferrer')
      .footer__links
        a.footer__link(:href='content.phone.phone_link')
          AppIcon.footer__link-icon(name='phone')
        a.footer__link(v-for='link, i in content.social_media', :key='i', :href='link.link')
          AppIcon.footer__link-icon(:name='link.icon')        
      
