.footer-mobile(v-if='content')
  .footer-mobile__nocss
    .footer-mobile__container
      .footer-mobile__links-bar
        a.footer-mobile__link(:href='content.phone.phone_link' target='_blanks')
          AppIcon.footer-mobile__icon(name='phone')
          .footer-mobile__text Call Us
        a.footer-mobile__link(href='mailto:info@reynolds-ortho.com')
          AppIcon.footer-mobile__icon(name='mail')
          .footer-mobile__text Email
        .footer-mobile__link.footer-mobile__popupicon(@click='showModal1')
          AppIcon.footer-mobile__icon(name='marker')
          .footer-mobile__text Address
    .footer-mobile__popup(style="display: none")
      .footer-mobile__popuplist
        h4  Indian Land
        p
          a(href='https://maps.app.goo.gl/PVpGyLqqMLuheQeq6' target='_blank')
            |  4174 Doby's Bridge Rd, Suite 102
            <br>
              |  Indian Land, SC 29707
      .footer-mobile__popuplist.footer-mobile__popuplist1
        h4  Fort Mill
        p
          a(href='https://maps.app.goo.gl/nkbu72Nyqi6Hwz5T6' target='_blank')
            |  364 Fort Mill Parkway, Suit 104
            <br>
              |  Fort Mill, SC 29715
      .footer-mobile__arrow