.navigation-mobile(:class="{ 'navigation-mobile--scrolling': fixed }")
  .navigation-mobile__navbar
    router-link.navigation-mobile__home(to='/' @click.native='closeDrawer')
      AppIcon.navigation-mobile__logo(name='logo-hero', :class="{ 'navigation-mobile__logo--drawer': drawerOpen }")
  
    .navigation-mobile__hamburger(@click='toggleDrawer', :class="{ 'navigation-mobile__hamburger--active': drawerOpen }")
      span
      span
      span
      span
      
  transition(name='fade')
    .navigation-mobile__overlay(v-if='drawerOpen')
  transition(name='drawer-slide')
    .navigation-mobile__drawer(v-if='drawerOpen', :class="{ 'navigation-mobile__drawer--open': drawerOpen }")
      ul.navigation-mobile__menu
        li.navigation-mobile__item(v-for='link, i in links', :key='i')
          router-link.navigation-mobile__link(:to='link.path' v-html='link.name' @click.native='closeDrawer')              
  
