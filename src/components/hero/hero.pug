.hero
  .hero__banner
    .hero__banner-content.hero__banner-content--desktop Too busy to call, send us a text: #[a.hero__phone-number(href='sms:+18036503061') 803.650.3061]
    .hero__banner-content.hero__banner-content--mobile Text Us: #[a.hero__phone-number(href='sms:+18036503061') 803.650.3061]
  .hero__overlay(:class="{ 'hero__overlay--light': $route.path === '/'}")
  .hero__bg(:style="{ backgroundImage: 'url(' + props.image + ')' }")
  //- video.hero__video(:src='props.video' muted preload autoplay loop)  
  .hero__content
    AppIcon.hero__logo(name='logo-hero' v-if='$route.path !== "/"')
    AppIcon.hero__logo.hero__logo--home(name='logo-main' v-if='$route.path === "/"')  
    .hero__title(v-html='props.title' v-if='$route.path !== "/"')    
