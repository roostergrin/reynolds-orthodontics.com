.custom-home-welcome(v-waypoint='{active: true, callback: $_onScroll, options: intersectionOptions}', :class="{ 'custom-home-welcome--active': active || windowHeight >= 800 }")
  AppLazyBg.custom-home-welcome__image(:src='content.image')
  .custom-home-welcome__container
    .custom-home-welcome__content
      .custom-home-welcome__title(v-html='content.title')
      .custom-home-welcome__text(v-html='content.text')
      router-link.custom-home-welcome__link(to='/about') Find Out More      
      
  
