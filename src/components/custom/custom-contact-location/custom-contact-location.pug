.custom-contact-location
  .custom-contact-location__container
    .custom-contact-location__row
      .custom-contact-location__col-md-12
        .custom-contact-location__section-heading
          h3.custom-contact-location__section-heading1
    .custom-contact-location__row
      .custom-contact-location__col-grid
        .custom-contact-location__location-info
          .custom-contact-location__text-info.custom-contact-location__text-center
            h4.custom-contact-location__subheading(v-html='content.indheading')
            .custom-contact-location__list
              .custom-contact-location__listing
                a.custom-contact-location__linking(:href='content.glink' target='_blank')
                  .custom-contact-location__icon
                    AppIcon.custom-contact-location__icon1(name='marker-map')
                  .custom-contact-location__locationname(v-html='content.iadd')
      .custom-contact-location__col-grid
        .custom-contact-location__location-info
          .custom-contact-location__iframemap
          .custom-contact-location__text-info.custom-contact-location__text-center
            h4.custom-contact-location__subheading(v-html='content.fheading')
            .custom-contact-location__list
              .custom-contact-location__listing
                a.custom-contact-location__linking(:href='content.mglink' target='_blank')
                  .custom-contact-location__icon
                    AppIcon.custom-contact-location__icon1(name='marker-map')
                  .custom-contact-location__locationname(v-html='content.fortad')
    .custom-contact-location__row.custom-contact-location__mt-20
      .custom-contact-location__col-md-12
        .custom-contact-location__listing
          .custom-contact-location__icon
            AppIcon.custom-contact-location__icon1(name='phone')
          a.custom-contact-location__linking1(:href='content.telinfo' target='_blank')
            .custom-contact-location__locationname(v-if='content.cphone' v-html:span='content.cphone')