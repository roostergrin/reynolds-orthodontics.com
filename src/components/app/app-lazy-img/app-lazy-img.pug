.app-lazy-img(
  v-if='loaded'
  role='img'
  :aria-label='alt'
  :style="{ backgroundImage: 'url(' + currentImg + ')' }"
  v-waypoint="{ active: true, callback: onWaypoint, options: intersectionOptions }")
  .app-lazy-img__overlay(:style="{ backgroundColor: bgColor, position: 'absolute', top: '50%', left:'50%', transform: 'translate(-50%, -50%)', width: '100%', height: '100%' }" v-if='loading')
    .app-lazy-img__overlay-gif(:style="{ backgroundImage: 'url(' + animatedGif + ')', maxHeight: '3rem', maxWidth: '3rem', position: 'absolute', top: '50%', left:'50%', transform: 'translate(-50%, -50%)', width: '100%', height: '100%', backgroundSize: 'contain' }")
  img.sr-only(:src='currentImg', :alt='alt')
